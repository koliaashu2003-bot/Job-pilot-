# ==============================================================================
# JobPilot — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# NEXT_PUBLIC_* vars are exposed to the browser. Everything else is server-only.
# ==============================================================================

# --- Firebase (client SDK) ----------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (admin SDK, server-side) ----------------------------------------
# Paste the full service-account JSON as a single-line string (escaped).
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# --- Job APIs -----------------------------------------------------------------
# RapidAPI key for JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=
# RemoteOK needs no key.

# --- Claude API ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Gmail OAuth2 -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
# 32-byte base64 key used to encrypt stored OAuth refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=
